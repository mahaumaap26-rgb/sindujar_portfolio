# ── Sinduja Portfolio Backend — Environment Variables ──
# Copy this file to .env and fill in your values

# Server
PORT=3000
ALLOWED_ORIGIN=*

# Gmail credentials
# Use a Gmail App Password — NOT your login password
# How to get one: https://myaccount.google.com/apppasswords
GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to receive contact form notifications (can be same as GMAIL_USER)
NOTIFY_EMAIL=sinduja@gmail.com
